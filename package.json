  "scripts": {
    "start": "react-scripts start",
    "build": "env-cmd -f environments/.env.production react-scripts build",
    "check-versions": "echo 'Node JS version:' && node -v && node src/SCA-packageVersion.js",
    "build:dev": "npm run check-versions && env-cmd -f environments/.env.development react-scripts build",
    "build:qa": "env-cmd -f environments/.env.qa react-scripts build",
    "build:stg": "env-cmd -f environments/.env.stg react-scripts build",
    "build:nfr": "env-cmd -f environments/.env.nfr react-scripts build",
    "build:preprod": "env-cmd -f environments/.env.preprod react-scripts build",
    "build:dr": "env-cmd -f environments/.env.dr react-scripts build",
    "test": "env-cmd -f environments/.env.development react-scripts test --transformIgnorePatterns \"node_modules/(?!echarts)/\"",
    "test:file": "env-cmd -f environments/.env.development react-scripts test --transformIgnorePatterns \"node_modules/(?!echarts)/\" --testPathPattern",
    "eject": "react-scripts eject",
    "test:coverage": "npm test -- --coverage  --watchAll=false --maxWorkers=4"
  },
  "husky": {
    "hooks": {
      "pre-commit": "npx eslint . --ext .js,.jsx,.ts,.tsx --fix",
      "pre-push": "npm test -- --watchAll=false"
    }
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version",
      "ie 11"
    ]
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@types/autosuggest-highlight": "^3.2.0",
    "@types/file-saver": "^2.0.5",
    "@types/react-autosuggest": "^10.1.5",
    "@types/react-dom": "^19.0.3",
    "@types/react-json-editor-ajrm": "^2.5.3",
    "@types/react-test-renderer": "^18.0.0",
    "@types/redux-thunk": "^2.1.0",
